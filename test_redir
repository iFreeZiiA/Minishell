# Couleurs pour l'affichage
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Variables globales
TOTAL_TESTS=0
PASSED_TESTS=0
EXECUTABLE="redirections_ut"

print_header() {
    echo -e "${BLUE}================================================${NC}"
    echo -e "${BLUE}        TEST PARSING REDIRECTIONS 6.2${NC}"
    echo -e "${BLUE}================================================${NC}"
}

print_test_result() {
    local test_name="$1"
    local result="$2"
    
    TOTAL_TESTS=$((TOTAL_TESTS + 1))
    
    if [ "$result" -eq 0 ]; then
        echo -e "${GREEN}✓ $test_name${NC}"
        PASSED_TESTS=$((PASSED_TESTS + 1))
    else
        echo -e "${RED}✗ $test_name${NC}"
    fi
}

setup_test_files() {
    echo -e "${YELLOW}Configuration des fichiers de test...${NC}"
    
    # Création de fichiers temporaires
    echo "test content" > input.txt
    touch output.txt
    chmod 644 input.txt output.txt
    
    echo "Fichiers de test créés."
}

cleanup_test_files() {
    echo -e "${YELLOW}Nettoyage des fichiers de test...${NC}"
    
    rm -f input.txt output.txt append.txt heredoc_out.txt
    rm -f /tmp/test_minishell_*.txt
    
    echo "Fichiers de test supprimés."
}

run_redirection_input_tests() {
    echo -e "\n${YELLOW}=== TESTS REDIRECTIONS ENTRÉE ===${NC}"
    
    # Test redirection simple <
    ./"$EXECUTABLE" "cat < input.txt" > /dev/null 2>&1
    print_test_result "Redirection entrée <" $?
    
    # Test fichier inexistant
    ./"$EXECUTABLE" "cat < nonexistent.txt" > /dev/null 2>&1
    result=$?
    if [ "$result" -ne 0 ]; then
        result=0  # On s'attend à un échec
    else
        result=1
    fi
    print_test_result "Fichier inexistant (erreur attendue)" $result
}

run_redirection_output_tests() {
    echo -e "\n${YELLOW}=== TESTS REDIRECTIONS SORTIE ===${NC}"
    
    # Test redirection simple >
    ./"$EXECUTABLE" "echo hello > output.txt" > /dev/null 2>&1
    print_test_result "Redirection sortie >" $?
    
    # Test redirection append >>
    ./"$EXECUTABLE" "echo world >> append.txt" > /dev/null 2>&1
    print_test_result "Redirection append >>" $?
    
    # Test permissions
    touch /tmp/test_minishell_readonly.txt
    chmod 444 /tmp/test_minishell_readonly.txt
    ./"$EXECUTABLE" "echo test > /tmp/test_minishell_readonly.txt" > /dev/null 2>&1
    result=$?
    if [ "$result" -ne 0 ]; then
        result=0  # On s'attend à un échec
    else
        result=1
    fi
    print_test_result "Fichier lecture seule (erreur attendue)" $result
    rm -f /tmp/test_minishell_readonly.txt
}

run_heredoc_tests() {
    echo -e "\n${YELLOW}=== TESTS HEREDOC ===${NC}"
    
    # Test heredoc simple
    ./"$EXECUTABLE" "cat << EOF" > /dev/null 2>&1
    print_test_result "Heredoc simple <<" $?
    
    # Test heredoc avec délimiteur custom
    ./"$EXECUTABLE" "cat << DELIMITER" > /dev/null 2>&1
    print_test_result "Heredoc délimiteur custom" $?
}

run_multiple_redirections_tests() {
    echo -e "\n${YELLOW}=== TESTS REDIRECTIONS MULTIPLES ===${NC}"
    
    # Test entrée + sortie
    ./"$EXECUTABLE" "cat < input.txt > output.txt" > /dev/null 2>&1
    print_test_result "Entrée + Sortie" $?
    
    # Test multiples sorties (doit échouer)
    ./"$EXECUTABLE" "echo test > file1.txt > file2.txt" > /dev/null 2>&1
    result=$?
    if [ "$result" -ne 0 ]; then
        result=0  # On s'attend à un échec
    else
        result=1
    fi
    print_test_result "Multiples sorties (erreur attendue)" $result
}

run_syntax_error_tests() {
    echo -e "\n${YELLOW}=== TESTS ERREURS SYNTAXE ===${NC}"
    
    # Test redirection sans fichier
    ./"$EXECUTABLE" "echo test >" > /dev/null 2>&1
    result=$?
    if [ "$result" -ne 0 ]; then
        result=0  # On s'attend à un échec
    else
        result=1
    fi
    print_test_result "Redirection sans fichier" $result
    
    # Test heredoc sans délimiteur
    ./"$EXECUTABLE" "cat <<" > /dev/null 2>&1
    result=$?
    if [ "$result" -ne 0 ]; then
        result=0  # On s'attend à un échec
    else
        result=1
    fi
    print_test_result "Heredoc sans délimiteur" $result
}

print_summary() {
    echo -e "\n${BLUE}================================================${NC}"
    echo -e "${BLUE}             RÉSUMÉ DES TESTS${NC}"
    echo -e "${BLUE}================================================${NC}"
    echo -e "Tests réussis: ${GREEN}$PASSED_TESTS${NC}/$TOTAL_TESTS"
    
    if [ "$PASSED_TESTS" -eq "$TOTAL_TESTS" ]; then
        echo -e "${GREEN}🎉 TOUS LES TESTS SONT PASSÉS !${NC}"
        return 0
    else
        echo -e "${RED}❌ CERTAINS TESTS ONT ÉCHOUÉ${NC}"
        return 1
    fi
}

main() {
    print_header
    
    # Vérification des prérequis
    if [ ! -f "$EXECUTABLE" ]; then
        echo -e "${RED}Erreur: Exécutable '$EXECUTABLE' non trouvé${NC}"
        echo -e "${YELLOW}Compilez d'abord avec: make lexing${NC}"
        exit 1
    fi
    
    # Configuration
    setup_test_files
    
    # Exécution des tests
    run_redirection_input_tests
    run_redirection_output_tests
    run_heredoc_tests
    run_multiple_redirections_tests
    run_syntax_error_tests
    
    # Nettoyage
    cleanup_test_files
    
    # Résumé
    print_summary
    exit $?
}

# Gestion des signaux
trap cleanup_test_files EXIT

# Exécution
main "$@"
